# Website env. Copy to .env and fill in. .env is gitignored — never commit it.

# --- Read-only, safe to expose. Public dataset, no token. ---
# These are bundled into the browser JavaScript by Create React App.
# The same two go into the Render site service's environment (step 17).
REACT_APP_SANITY_PROJECT_ID=
REACT_APP_SANITY_DATASET=production

# Painting inquiry form. Render has no built-in form handling, so submissions
# go to Formspree (Render's documented addon). Create a form at formspree.io and
# paste its endpoint here and in the Render site service's environment.
# Unset means the form tells visitors to email instead of pretending to send.
REACT_APP_FORMSPREE_ENDPOINT=

# --- Migration script only (scripts/migration/migrate-to-sanity.mjs). ---
# Local machine only. Never on Render, never in the browser bundle, never committed.
# Delete SANITY_WRITE_TOKEN once the one-off migration in step 9 is done.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=
