{
  "homepage": "https://dfvro.com",
  "name": "dfo-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.1",
    "@mui/material": "^5.15.1",
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^8.8.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "babel-plugin-macros": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-responsive": "^9.0.2",
    "react-router-dom": "^7.18.4",
    "react-scripts": "5.0.1",
    "sass": "^1.69.5"
  },
  "scripts": {
    "prestart": "node scripts/generate-build-info.js && node scripts/fetch-content-snapshot.js",
    "start": "react-scripts start",
    "prebuild": "node scripts/generate-build-info.js && node scripts/fetch-content-snapshot.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "sync-instagram": "node scripts/sync-instagram.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(@portabletext|@sanity)/)",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "css-select": "^5.2.2",
    "postcss": "^8.5.28",
    "serialize-javascript": "^7.1.2",
    "underscore": "^1.13.8",
    "@tootallnate/once": "^2.0.1",
    "jsonpath": {
      "underscore": "^1.13.8"
    },
    "uuid": "^9.0.1",
    "svgo": "^3.3.2"
  }
}
